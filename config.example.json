{
  "database": "./data/aios.db",
  "workspace": "./workspace",
  "poll_interval_seconds": 2.0,
  "max_actions_per_cycle": 8,
  "runtime": {
    "completion_mode": "free"
  },
  "self_modification": {
    "enabled": true,
    "root": "./self",
    "experiment_condition": "natural",
    "max_system_prompt_characters": 8000
  },
  "budget": {
    "enabled": true,
    "max_model_calls_per_cycle": 6,
    "max_tool_calls_per_cycle": 8,
    "max_model_calls_per_task": 24,
    "max_tool_calls_per_task": 32,
    "max_tokens_per_task": 300000,
    "soft_model_calls_per_task": 12,
    "soft_tokens_per_task": 120000,
    "max_cycles_per_task": 6,
    "tool_observation_characters": 12000,
    "hot_tool_results": 2,
    "working_state_characters": 8000,
    "reserved_completion_tool_calls": 1
  },
  "evolution": {
    "enabled": false,
    "auto_promote": false,
    "trigger_repetitions": 2,
    "retry_after_evolution": false,
    "extensions_path": "./extensions"
  },
  "capabilities": {
    "network_enabled": false,
    "allowed_domains": []
  },
  "sandbox": {
    "backend": "docker",
    "image": "python:3.12-slim",
    "default_timeout_seconds": 60,
    "max_timeout_seconds": 300,
    "memory_mb": 512,
    "cpus": 1.0,
    "pids_limit": 128,
    "health_ttl_seconds": 30,
    "root": "./sandbox"
  },
  "skills": {
    "enabled": false,
    "bootstrap_builtins": true,
    "root": "./skills",
    "require_human_promotion": true,
    "max_source_bytes": 131072,
    "benchmark_timeout_seconds": 30
  },
  "experiments": {
    "root": "./experiments",
    "default_runs_per_variant": 3,
    "keep_worlds": false,
    "semantic_judge_enabled": false
  },
  "model": {
    "provider": "mock",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5-mini",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 60,
    "max_tokens": 2048,
    "temperature": 0.1,
    "thinking": "enabled",
    "protocol": "tool_calling"
  },
  "permissions": {
    "allowed_tools": ["read", "write", "edit", "bash", "evolve"],
    "allow_writes": true,
    "max_read_bytes": 1048576,
    "max_write_bytes": 1048576
  }
}
