{
  "database": "./data/aios.db",
  "workspace": "./workspace",
  "poll_interval_seconds": 2.0,
  "max_actions_per_cycle": 8,
  "budget": {
    "max_model_calls_per_cycle": 4,
    "max_tool_calls_per_cycle": 8,
    "reserved_completion_tool_calls": 1
  },
  "evolution": {
    "enabled": false,
    "auto_promote": false,
    "trigger_repetitions": 2,
    "retry_after_evolution": false,
    "extensions_path": "./extensions"
  },
  "capabilities": {
    "network_enabled": false,
    "allowed_domains": []
  },
  "sandbox": {
    "backend": "docker",
    "image": "python:3.12-slim",
    "timeout_seconds": 60,
    "memory_mb": 512,
    "cpus": 1.0,
    "pids_limit": 128,
    "root": "./sandbox"
  },
  "skills": {
    "enabled": true,
    "root": "./skills",
    "require_human_promotion": true,
    "max_source_bytes": 131072,
    "benchmark_timeout_seconds": 30
  },
  "experiments": {
    "root": "./experiments",
    "default_runs_per_variant": 3,
    "keep_worlds": false,
    "semantic_judge_enabled": false
  },
  "model": {
    "provider": "mock",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5-mini",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 60,
    "max_tokens": 2048,
    "temperature": 0.1,
    "thinking": "disabled",
    "protocol": "tool_calling"
  },
  "permissions": {
    "allowed_tools": ["read", "write", "edit", "bash"],
    "allow_writes": true,
    "max_read_bytes": 1048576,
    "max_write_bytes": 1048576
  }
}
