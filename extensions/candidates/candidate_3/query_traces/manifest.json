{
  "name": "query_traces",
  "version": "0.1.0",
  "description": "Query recent structured AIOS execution traces.",
  "parameters": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "status": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "kind": "state_query",
  "config": {
    "source": "traces"
  },
  "permissions": {
    "database": "read_only",
    "filesystem": "none",
    "network": false,
    "subprocess": false
  }
}